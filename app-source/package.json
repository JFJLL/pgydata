{
  "name": "magiorix-desktop",
  "productName": "magiorix",
  "version": "1.4.4",
  "assetsVersion": "1.4.4",
  "description": "Local PGY data collection desktop client",
  "main": "dist-electron/index.js",
  "type": "module",
  "author": "magiorix",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:mac:arm64": "electron-builder --mac dmg --arm64",
    "build:mac:x64": "electron-builder --mac dmg --x64",
    "build:mac:universal": "electron-builder --mac dmg --universal",
    "pack:mac": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/react": "^6.0.2",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@mui/x-date-pickers": "^8.26.0",
    "@volcengine/openapi": "^1.35.0",
    "apexcharts": "^5.3.6",
    "axios": "^1.7.7",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "electron-updater": "^6.7.3",
    "file-saver": "^2.0.5",
    "form-data": "^4.0.5",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.0.9",
    "node-cron": "^3.0.3",
    "nprogress": "^0.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "unzipper": "^0.12.3",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "cn.red-magic.magiorix",
    "productName": "magiorix",
    "directories": {
      "output": "dist-mac"
    },
    "files": [
      "dist-electron/**/*",
      "electron-main/**/*",
      "pgy-kol/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/static",
        "to": "dist-electron/static"
      }
    ],
    "mac": {
      "icon": "dist-electron/static/logo.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "magiorix ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
