PORT=3050
BASE_URL=https://api.red-magic.cn
PAY_BASE_URL=https://api.red-magic.cn
DEFAULT_GIFT_BALANCE=100
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
LOG_DIR=./logs

# 阿里云短信：真实值只放部署环境的 .env，不写入仓库。
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION_ID=cn-beijing
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=北京易美广告
ALIYUN_SMS_TEMPLATE_CODE=SMS_499290595
SMS_CODE_SECRET=

# 微信支付 API v3 / Native
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.red-magic.cn/order

# 支付宝电脑网站支付
